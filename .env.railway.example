# ==============================================================================
# RAILWAY VARIABLES TEMPLATE
# Paste into: app service -> Variables -> RAW Editor
# (Set these on the APP service, NOT on the MySQL service.)
# ==============================================================================

# Application
APP_NAME="Online Banking"
APP_ENV=production
# Generate your own on a Mac:  echo "base64:$(openssl rand -base64 32)"
APP_KEY=
APP_DEBUG=false
APP_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}

# Admin login (applied on every start; delete ADMIN_PASSWORD afterwards
# if you want to change the password from the admin panel instead)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=error

# Database - requires a MySQL service named "MySQL" in the same project
DB_CONNECTION=mysql
DB_HOST=${{MySQL.MYSQLHOST}}
DB_PORT=${{MySQL.MYSQLPORT}}
DB_DATABASE=${{MySQL.MYSQLDATABASE}}
DB_USERNAME=${{MySQL.MYSQLUSER}}
DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}

# Drivers
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
